    "publint": "catalog:build",
    "resize-observer-polyfill": "catalog:solid-test",
    "solid-js": "catalog:framework",
    "storybook-solidjs-vite": "catalog:stories",
    "typescript": "catalog:types",
    "unplugin-solid": "catalog:solid-build",
    "vite": "catalog:runtime",
    "vite-plugin-solid": "catalog:solid-build",
