{
  "name": "@destyler-ui/solid",
  "type": "module",
  "version": "0.0.1-beta.17",
  "description": "Build scalable design systems with unstyled, accessible UI components for Solid",
  "author": "Elone Hoo <hi@elonehoo.me>",
  "license": "MIT",
  "homepage": "https://github.com/destyler/ui",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/destyler/ui.git",
    "directory": "packages/solid"
  },
  "bugs": "https://github.com/destyler/ui/issues",
  "keywords": [
    "base",
    "destyler",
    "solid"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "solid": "./dist/index.jsx",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./anatomy": {
      "types": "./dist/anatomy.d.ts",
      "solid": "./dist/anatomy.jsx",
      "import": "./dist/anatomy.js",
      "default": "./dist/anatomy.js"
    },
    "./collection": {
      "types": "./dist/utils/collection.d.ts",
      "solid": "./dist/utils/collection.jsx",
      "import": "./dist/utils/collection.js",
      "default": "./dist/utils/collection.js"
    },
    "./factory": {
      "types": "./dist/factory/index.d.ts",
      "solid": "./dist/factory/index.jsx",
      "import": "./dist/factory/index.js",
      "default": "./dist/factory/index.js"
    },
    "./client-only": {
      "types": "./dist/providers/client-only/index.d.ts",
      "solid": "./dist/providers/client-only/index.jsx",
      "import": "./dist/providers/client-only/index.js",
      "default": "./dist/providers/client-only/index.js"
    },
    "./environment": {
      "types": "./dist/providers/environment/index.d.ts",
      "solid": "./dist/providers/environment/index.jsx",
      "import": "./dist/providers/environment/index.js",
      "default": "./dist/providers/environment/index.js"
    },
    "./focus-trap": {
      "types": "./dist/providers/focus-trap/index.d.ts",
      "solid": "./dist/providers/focus-trap/index.jsx",
      "import": "./dist/providers/focus-trap/index.js",
      "default": "./dist/providers/focus-trap/index.js"
    },
    "./format": {
      "types": "./dist/providers/format/index.d.ts",
      "solid": "./dist/providers/format/index.jsx",
      "import": "./dist/providers/format/index.js",
      "default": "./dist/providers/format/index.js"
    },
    "./frame": {
      "types": "./dist/providers/frame/index.d.ts",
      "solid": "./dist/providers/frame/index.jsx",
      "import": "./dist/providers/frame/index.js",
      "default": "./dist/providers/frame/index.js"
    },
    "./highlight": {
      "types": "./dist/providers/highlight/index.d.ts",
      "solid": "./dist/providers/highlight/index.jsx",
      "import": "./dist/providers/highlight/index.js",
      "default": "./dist/providers/highlight/index.js"
    },
    "./locale": {
      "types": "./dist/providers/locale/index.d.ts",
      "solid": "./dist/providers/locale/index.jsx",
      "import": "./dist/providers/locale/index.js",
      "default": "./dist/providers/locale/index.js"
    },
    "./*": {
      "types": "./dist/components/*/index.d.ts",
      "solid": "./dist/components/*/index.jsx",
      "import": "./dist/components/*/index.js",
      "default": "./dist/components/*/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "LICENSE",
    "README.md",
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "storybook": "storybook dev -p 6009",
    "build-storybook": "storybook build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --browser.headless && vitest run --config vitest.ssr.config.ts",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:dev": "vitest --browser.headless",
    "test:ui": "vitest --ui --open",
    "lint:package": "publint",
    "check:package-files": "node ./scripts/check-package-files.cjs",
    "check:package-types": "tsc --project ./tsconfig.package-consumer.json",
    "check": "pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package-types && pnpm run check:package-files && pnpm run lint:package",
    "prepack": "pnpm run check"
  },
  "peerDependencies": {
    "solid-js": ">=1.8.0 <2.0.0"
  },
  "dependencies": {
    "@destyler/anatomy": "catalog:prod",
