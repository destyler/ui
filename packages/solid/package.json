    "@destyler/file-upload": "catalog:prod",
    "@destyler/floating-panel": "catalog:prod",
    "@destyler/focus-trap": "catalog:prod",
    "@destyler/highlight-text": "catalog:prod",
    "@destyler/hover-card": "catalog:prod",
    "@destyler/i18n": "catalog:prod",
    "@destyler/image": "catalog:prod",
    "@destyler/label": "catalog:prod",
    "@destyler/menu": "catalog:prod",
    "@destyler/navigation-menu": "catalog:prod",
    "@destyler/number-input": "catalog:prod",
    "@destyler/otp-input": "catalog:prod",
    "@destyler/pagination": "catalog:prod",
    "@destyler/popover": "catalog:prod",
    "@destyler/presence": "catalog:prod",
    "@destyler/progress": "catalog:prod",
    "@destyler/qr-code": "catalog:prod",
    "@destyler/radio": "catalog:prod",
    "@destyler/scroll-area": "catalog:prod",
    "@destyler/select": "catalog:prod",
    "@destyler/separator": "catalog:prod",
    "@destyler/signature": "catalog:prod",
    "@destyler/slider": "catalog:prod",
    "@destyler/solid": "catalog:prod",
    "@destyler/splitter": "catalog:prod",
    "@destyler/steps": "catalog:prod",
    "@destyler/store": "catalog:prod",
    "@destyler/switch": "catalog:prod",
    "@destyler/tabs": "catalog:prod",
    "@destyler/timer": "catalog:prod",
    "@destyler/toast": "catalog:prod",
    "@destyler/toggle": "catalog:prod",
    "@destyler/tooltip": "catalog:prod",
    "@destyler/tour": "catalog:prod",
