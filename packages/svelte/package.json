  "scripts": {
    "build": "pnpm run sync:manifest:check && pnpm run clean && svelte-kit sync && svelte-package --tsconfig ./tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "svelte-kit sync && svelte-package --watch --tsconfig ./tsconfig.build.json",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "sync:manifest": "node scripts/sync-manifest.cjs",
    "sync:manifest:check": "node scripts/sync-manifest.cjs --check",
    "check:manifest": "pnpm run sync:manifest:check && node scripts/test-component-generator.cjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run --browser.headless && vitest run --config vitest.ssr.config.ts",
    "test:ssr": "vitest run --config vitest.ssr.config.ts",
    "test:dev": "vitest --browser.headless",
    "test:ui": "vitest --ui --open",
    "lint:package": "publint",
    "check:package-files": "node scripts/check-package-files.cjs",
    "check:ci": "pnpm run check:manifest && pnpm run typecheck && pnpm run build && pnpm run lint:package && pnpm run check:package-files",
    "check": "pnpm run check:manifest && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run lint:package && pnpm run check:package-files",
    "prepack": "pnpm run check"
  },
