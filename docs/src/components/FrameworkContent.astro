---
/**
 * FrameworkContent — shows/hides its content based on the active framework.
 *
 * Usage in MDX:
 *   import FrameworkContent from '../../../components/FrameworkContent.astro';
 *
 *   <FrameworkContent fw="vue">
 *     ```vue
 *     <template>...</template>
 *     ```
 *   </FrameworkContent>
 *
 *   <FrameworkContent fw="react">
 *     ```tsx
 *     export default function App() { ... }
 *     ```
 *   </FrameworkContent>
 *
 * Props:
 *   - fw: "vue" | "react" | "svelte" — which framework this content belongs to.
 */

import type { Framework } from '../config/frameworks'

interface Props {
  fw: Framework
}

const { fw } = Astro.props
---

<div class="ds-fw-content not-content" data-fw={fw}>
  <slot />
</div>
